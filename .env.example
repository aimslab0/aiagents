SECRET_KEY=
# Production: False. Local HTTP development: explicitly set DEBUG=True.
DEBUG=False
OPENROUTER_API_KEY=
# balanced = GPT + Gemini + Qwen, judged by Grok. deep retains the Claude setup.
RESEARCH_MODE=balanced
BALANCED_GPT_MODEL=openai/gpt-6-astra
BALANCED_GEMINI_MODEL=google/gemini-3.1-pro-preview
BALANCED_THIRD_MODEL=qwen/qwen3.8-max-0902
BALANCED_SYNTHESIZER_MODEL=x-ai/grok-4.20
# Legacy research-model variables below are Deep agent defaults; DEEP_* overrides win.
DEEP_GPT_MODEL=
DEEP_GEMINI_MODEL=
DEEP_CLAUDE_MODEL=
DEEP_SYNTHESIZER_GPT_MODEL=openai/gpt-6-astra
DEEP_SYNTHESIZER_CLAUDE_MODEL=anthropic/claude-fable-5.1
DEEP_SYNTHESIZER_GROK_MODEL=x-ai/grok-4.20
DEEP_DEFAULT_SYNTHESIZER=gpt
GPT_MODEL=openai/gpt-6-astra
CLAUDE_MODEL=anthropic/claude-opus-5
GEMINI_MODEL=google/gemini-3.1-pro-preview
# Legacy OPENROUTER_GPT/CLAUDE/GEMINI_MODEL names remain supported as fallbacks.
# False selects paid production models; True selects the unchanged free models below.
OPENROUTER_FREE_TEST_MODE=False
FREE_TEST_MODEL_1=nex-agi/nex-n2.5-pro:free
FREE_TEST_MODEL_2=dots-studio/dots-3-note-preview:free
FREE_TEST_MODEL_3=nvidia/nemotron-3-super-120b-a12b:free
FREE_TEST_SYNTHESIZER_MODEL=nex-agi/nex-n2.5-pro:free
OPENROUTER_CONNECT_TIMEOUT=5
OPENROUTER_READ_TIMEOUT=120
OPENROUTER_MAX_TOKENS=4096
CONSENSUS_API_KEY=
CONSENSUS_CONNECT_TIMEOUT=5
CONSENSUS_READ_TIMEOUT=30
CONSENSUS_PAGE_SIZE=20
CONSENSUS_YEAR_MIN=
# Optional documented study types, e.g. systematic review,meta-analysis
CONSENSUS_STUDY_TYPES=
# Preserved legacy judge choice; new runs use Balanced/Deep selectors above.
SYNTHESIZER_MODEL=anthropic/claude-fable-5.1
SYNTHESIZER_TIMEOUT=180
SYNTHESIZER_MAX_TOKENS=6000
SYNTHESIS_MAX_AGENT_CHARS=6000
SYNTHESIS_MAX_AGENTS=3
SYNTHESIS_MAX_PAPERS=8
SYNTHESIS_MAX_ABSTRACT_CHARS=2000
SYNTHESIS_MAX_CONTEXT_CHARS=80000
SYNTHESIS_CLAIM_SIMILARITY=0.8
# Enable only for research where recency is relevant.
SYNTHESIS_USE_RECENCY=False
SYNTHESIS_WEIGHT_RELEVANCE=40
SYNTHESIS_WEIGHT_REVIEW=15
SYNTHESIS_WEIGHT_PEER_REVIEW=5
SYNTHESIS_WEIGHT_JOURNAL_QUARTILE=5
SYNTHESIS_WEIGHT_CITATIONS=3
SYNTHESIS_WEIGHT_SAMPLE_SIZE=2
SYNTHESIS_WEIGHT_RECENCY=3
SYNTHESIS_WEIGHT_AGENT_CITATION=0.5
SYNTHESIS_WEIGHT_AGENT_ACADEMIC_LINK=2
# Production: your exact hostname, without scheme. Local: localhost,127.0.0.1,[::1]
ALLOWED_HOSTS=
# Comma-separated HTTPS origins, including scheme, without trailing slash.
CSRF_TRUSTED_ORIGINS=

# Step 5: local evaluation and diagnostics
RESEARCH_DIAGNOSTICS_ENABLED=True
RESEARCH_COST_TRACKING_ENABLED=True
# Optional additional allowlisted judges; the default SYNTHESIZER_MODEL is always included.
SYNTHESIZER_MODELS=
# USD per million input/output tokens, keyed by exact model ID. Empty means no fallback estimate.
# Example shape only: {"provider/model":{"input_per_million":"verified_rate","output_per_million":"verified_rate"}}
OPENROUTER_MODEL_PRICING={}

# Step 6: retries are opt-in. Values mean additional attempts, not total calls (0-5).
OPENROUTER_MAX_RETRIES=0
CONSENSUS_MAX_RETRIES=0
PROVIDER_RETRY_BACKOFF=2
GPT_ENABLED=True
CLAUDE_ENABLED=True
GEMINI_ENABLED=True
CONSENSUS_ENABLED=True
SYNTHESIS_ENABLED=True
# Optional overrides; blanks inherit the shared OpenRouter/Consensus/judge settings.
GPT_TIMEOUT=
GPT_MAX_TOKENS=
GPT_MAX_RETRIES=
GPT_RETRY_BACKOFF=
CLAUDE_TIMEOUT=
CLAUDE_MAX_TOKENS=
CLAUDE_MAX_RETRIES=
CLAUDE_RETRY_BACKOFF=
GEMINI_TIMEOUT=
GEMINI_MAX_TOKENS=
GEMINI_MAX_RETRIES=
GEMINI_RETRY_BACKOFF=
CONSENSUS_TIMEOUT=
CONSENSUS_RETRY_BACKOFF=
# Consensus is a search API: use CONSENSUS_PAGE_SIZE above, not a token budget.
SYNTHESIS_TIMEOUT=
SYNTHESIS_MAX_TOKENS=
SYNTHESIS_MAX_RETRIES=
SYNTHESIS_RETRY_BACKOFF=
RESEARCH_STALE_AFTER_SECONDS=900
MIN_CONSENSUS_PAPERS_FOR_STRONG_EVIDENCE=2
MIN_VALID_SOURCES_FOR_SYNTHESIS=1
MIN_SUCCESSFUL_AGENTS=1
